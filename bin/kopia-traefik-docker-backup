#!/usr/bin/env python3
"""
kopia-traefik-docker-backup — Snapshot the traefik.hirschnet /home/nat/docker
directory (compose stack config, dotfile secrets like .bao-unseal-key,
.env.openbao, service DBs) via the kopia-webui container.

git covers the committed code, but not gitignored secrets (.env*, OpenBao's
unseal key/init output, htpasswd, authelia secrets) — those only exist here.
Bulk regenerable cache/log dirs are excluded via kopia policy (see
`kopia policy show /data/traefik-docker`), not this script.

Usage:
  kopia-traefik-docker-backup
"""

import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _openbao import fetch_secrets

secrets = fetch_secrets()
repo_pw = secrets.get("KOPIA_REPO_PW")
if not repo_pw:
    print("Error: KOPIA_REPO_PW not found in OpenBao (kv/docker/misc)", file=sys.stderr)
    sys.exit(1)

result = subprocess.run(
    ["docker", "exec", "-e", f"KOPIA_PASSWORD={repo_pw}",
     "kopia-webui", "kopia", "snapshot", "create", "/data/traefik-docker"],
    capture_output=True, text=True,
)
print(result.stdout, end="")
print(result.stderr, end="", file=sys.stderr)
sys.exit(result.returncode)
