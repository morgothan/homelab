#!/usr/bin/env python3
"""
update-images — detect and apply Docker image updates across three categories:

  1. Semver-pinned images  — find newer version tags via skopeo list-tags
  2. Rolling-tag images    — pull if remote digest differs from local cache
  3. Local builds          — rebuild (--pull) if Dockerfile base image changed

Usage:
  bin/update-images              # interactive: show changes, prompt to apply
  bin/update-images --dry-run    # check only, no changes
  bin/update-images --yes        # skip confirmation prompt
  bin/update-images --all        # also update beszel/whisper/spark/hermes/sketchy-nas over SSH
  bin/update-images --edge-gateway  # include HAProxy (brief direct-LAN interruption)
  bin/update-images --no-commit  # skip the automatic git commit + push of tag bumps

After a successful deploy the compose-file tag bumps are committed and pushed
automatically, unless the diff contains a leak marker (see LEAK_MARKERS) or
--no-commit is given.
"""

import argparse
import asyncio
import json
import platform
import re
import subprocess
import sys
from pathlib import Path
from typing import Optional

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _openbao import fetch_secrets

REPO_ROOT = Path(__file__).resolve().parent.parent

COMPOSE_FILES = [
    REPO_ROOT / "docker-compose.yml",
    REPO_ROOT / "docker-compose.edge.yml",
    REPO_ROOT / "docker-compose.openbao.yml",
]
EDGE_COMPOSE = REPO_ROOT / "docker-compose.edge.yml"

_SEMVER_RE = re.compile(r"^v?\d+\.\d+")
_SEM_SIZE = 6  # concurrent skopeo requests

_SECRETS = fetch_secrets()
LOCAL = _SECRETS.get("LOCAL", "")

# Remote hosts with their own ~/docker/dc.sh stack — updated via `--all`
REMOTE_DC_HOSTS = [f"beszel.{LOCAL}", f"whisper.{LOCAL}", f"spark.{LOCAL}", f"spark2.{LOCAL}", f"hermes.{LOCAL}"]
REMOTE_DC_CMD = "cd ~/docker && ./dc.sh pull && ./dc.sh up -d && docker system prune -fa"
SKETCHY_NAS_HOST = f"sketchy-nas.{LOCAL}"
SKETCHY_NAS_CMD = "~/docker-update.sh"

# ── sort / pattern helpers ─────────────────────────────────────────────────────

def _sort_key(tag: str) -> tuple:
    match = re.match(r"^v?(\d+)\.(\d+)(?:\.(\d+))?", tag)
    if not match:
        return (0,)
    return tuple(int(x) for x in match.groups() if x is not None)


def _tag_pattern(tag: str) -> Optional[re.Pattern]:
    """Regex matching tags with the same format (component count, v-prefix) as tag."""
    match = re.match(r"^(v?)(\d+)\.(\d+)(?:\.(\d+))?(.*)$", tag)
    if not match:
        return None
    prefix, _, _, patch, suffix = match.groups()
    n = r"\d+"
    escaped_suffix = re.escape(suffix)
    if patch is not None:
        pat = rf"^{prefix}{n}\.{n}\.{n}{escaped_suffix}$"
    else:
        pat = rf"^{prefix}{n}\.{n}{escaped_suffix}$"
    return re.compile(pat)


# ── skopeo wrappers ────────────────────────────────────────────────────────────

_TRANSIENT_MARKERS = ("500", "502", "503", "504", "timeout", "timed out",
                      "deadline", "connection reset", "connection refused", "eof")


def _is_transient(err: str) -> bool:
    low = err.lower()
    return any(m in low for m in _TRANSIENT_MARKERS)


async def _skopeo_run(
    args: list, sem: asyncio.Semaphore, retries: int = 2
) -> tuple[Optional[bytes], str]:
    """Run a skopeo command, retrying up to `retries` times on transient errors."""
    last_err = ""
    for attempt in range(retries + 1):
        async with sem:
            proc = await asyncio.create_subprocess_exec(
                *args,
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE,
            )
            out, err = await proc.communicate()
        if proc.returncode == 0:
            return out, ""
        last_err = err.decode().strip()
        if attempt < retries and _is_transient(last_err):
            await asyncio.sleep(2 ** attempt)  # 1s, 2s
        else:
            break
    return None, last_err


async def _skopeo_list_tags(image: str, sem: asyncio.Semaphore) -> list[str]:
    """Return all tags for an image; tries unauthenticated first, then with auth."""
    last_err = ""
    for flags in (["--no-creds"], []):
        out, last_err = await _skopeo_run(["skopeo", "list-tags", *flags, f"docker://{image}"], sem)
        if out is not None:
            try:
                return json.loads(out).get("Tags") or []
            except json.JSONDecodeError:
                return []
    print(f"  [warn] skopeo list-tags {image}: {last_err}", file=sys.stderr)
    return []


async def _remote_digest(ref: str, sem: asyncio.Semaphore) -> Optional[str]:
    """Fetch remote manifest digest; tries unauthenticated first, then with auth."""
    last_err = ""
    for flags in (["--no-creds"], []):
        out, last_err = await _skopeo_run(["skopeo", "inspect", *flags, f"docker://{ref}"], sem)
        if out is not None:
            try:
                return json.loads(out).get("Digest")
            except json.JSONDecodeError:
                return None
    # Fallback for multi-arch images where skopeo can't resolve the host platform
    # (e.g. owasp/modsecurity-crs:nginx-alpine): parse the raw manifest index and
    # return the best available platform digest.
    host_arch = {"x86_64": "amd64"}.get(platform.machine(), platform.machine())
    for flags in (["--no-creds"], []):
        out, _ = await _skopeo_run(["skopeo", "inspect", "--raw", *flags, f"docker://{ref}"], sem)
        if out is not None:
            try:
                manifests = json.loads(out).get("manifests", [])
                first = None
                for m in manifests:
                    p = m.get("platform", {})
                    d = m.get("digest")
                    if first is None:
                        first = d
                    if p.get("architecture") == host_arch and p.get("os") == "linux":
                        return d
                if first:
                    return first  # ponytail: best-effort; no exact arch match
            except (json.JSONDecodeError, KeyError):
                pass
            break
    print(f"  [warn] skopeo inspect {ref}: {last_err}", file=sys.stderr)
    return None


def _local_digests(ref: str) -> set[str]:
    """Return all sha256 digests from local Docker image cache, or empty set.

    An image can accumulate multiple RepoDigests entries when Docker Hub
    re-signs or re-pushes a manifest without changing the image content.
    Comparing only index 0 causes false-positive stale detection.
    """
    r = subprocess.run(
        ["docker", "image", "inspect", ref, "--format", "{{json .RepoDigests}}"],
        capture_output=True, text=True,
    )
    if r.returncode != 0 or not r.stdout.strip():
        return set()
    try:
        repo_digests = json.loads(r.stdout.strip())
    except json.JSONDecodeError:
        return set()
    result = set()
    for raw in repo_digests:
        if "@" in raw:
            result.add(raw.split("@", 1)[1])
        elif raw.startswith("sha256:"):
            result.add(raw)
    return result


# ── semver update check ────────────────────────────────────────────────────────

async def _latest_semver_tag(name: str, current: str, sem: asyncio.Semaphore) -> Optional[str]:
    """Return newest matching tag if newer than current and manifest is pullable, else None."""
    pat = _tag_pattern(current)
    if not pat:
        return None
    tags = await _skopeo_list_tags(name, sem)
    matching = [t for t in tags if pat.match(t)]
    if not matching:
        return None
    # Guard against date-stamped nightly build tags (e.g. kopia's 20260522.0.215720)
    # being ranked above conventional semver tags (0.23.0).
    if _sort_key(current)[0] < 10_000:
        matching = [t for t in matching if _sort_key(t)[0] < 10_000]
    if not matching:
        return None
    best = max(matching, key=_sort_key)
    if _sort_key(best) <= _sort_key(current):
        return None
    # Confirm the tag has a valid, pullable manifest before reporting it as an update.
    # A tag can appear in list-tags but have no manifest if it was partially pushed or deleted.
    if await _remote_digest(f"{name}:{best}", sem) is None:
        return None
    return best


# ── compose parsing ────────────────────────────────────────────────────────────

def _parse_compose(path: Path, include_edge_gateway: bool = False) -> dict:
    """
    Parse one compose file into three categories:
      semver:  [(full_ref, image_name, tag), ...]
      rolling: [(service_name, full_ref), ...]
      builds:  [(service_name, build_context_str), ...]

    Assumes build: appears before image: within each service block.
    """
    semver: list = []
    rolling: list = []
    builds: list = []
    cur_svc: Optional[str] = None
    cur_build: Optional[str] = None  # None=no build:, "__block__"=block form pending context:
    in_services = False

    def _flush():
        if cur_svc and cur_build is not None and cur_build != "__block__":
            builds.append((cur_svc, cur_build))

    for line in path.read_text().splitlines():
        # Track top-level sections (unindented keys)
        if re.match(r'^[a-zA-Z]', line):
            _flush()
            in_services = bool(re.match(r'^services\s*:', line))
            cur_svc = None
            cur_build = None
            continue

        if not in_services or re.match(r'\s*#', line):
            continue

        # Service name: exactly 2-space indent
        svc_m = re.match(r'^  ([a-zA-Z0-9_-]+)\s*:', line)
        if svc_m:
            _flush()
            cur_svc = svc_m.group(1)
            cur_build = None
            continue

        # build: <path>  (inline form)
        bm = re.match(r'^    build:\s+(\S+)', line)
        if bm:
            cur_build = bm.group(1)
            continue
        # build:         (block form — context: key follows)
        if re.match(r'^    build:\s*$', line):
            cur_build = "__block__"
            continue
        ctx_m = re.match(r'^      context:\s+(\S+)', line)
        if ctx_m and cur_build == "__block__":
            cur_build = ctx_m.group(1)
            continue

        # image: <ref>
        if (
            "update-images: ignore" in line
            and not (include_edge_gateway and path == EDGE_COMPOSE and cur_svc == "edge-gateway")
        ):
            continue
        img_m = re.match(r'^    image:\s+"?([^"#\s]+)"?', line)
        if not img_m:
            continue
        ref = img_m.group(1)

        # build: services use image: as the local tag name — not a registry pull target
        if cur_build is not None:
            continue

        # Resolve ${VAR} substitutions against OpenBao secrets (dc.sh injects these
        # the same way at deploy time — see e.g. POLLER_TAG for unpoller).
        if "$" in ref:
            ref = re.sub(r"\$\{(\w+)\}", lambda m: _SECRETS.get(m.group(1), m.group(0)), ref)
        # Skip anything still unresolved
        if "$" in ref:
            continue

        # Untagged — treat as :latest rolling
        if ":" not in ref.split("/")[-1]:
            rolling.append((cur_svc, ref + ":latest"))
            continue

        name, tag = ref.rsplit(":", 1)
        if _SEMVER_RE.match(tag):
            semver.append((ref, name, tag))
        else:
            rolling.append((cur_svc, ref))

    _flush()
    return {"semver": semver, "rolling": rolling, "builds": builds}


# ── Dockerfile FROM parsing ────────────────────────────────────────────────────

def _dockerfile_bases(context_str: str) -> list[str]:
    """Return all non-scratch FROM base images in <context>/Dockerfile."""
    ctx = Path(context_str)
    if not ctx.is_absolute():
        ctx = REPO_ROOT / ctx
    df = ctx / "Dockerfile"
    if not df.exists():
        return []
    bases = []
    for line in df.read_text().splitlines():
        m = re.match(r'^\s*FROM\s+(\S+)', line, re.IGNORECASE)
        if m and m.group(1).lower() not in ("scratch",):
            bases.append(m.group(1))
    return bases


# ── check everything ───────────────────────────────────────────────────────────

async def _check_all(include_edge_gateway: bool = False) -> dict:
    sem = asyncio.Semaphore(_SEM_SIZE)

    all_semver:  list = []  # (cf, full_ref, name, tag)
    all_rolling: list = []  # (cf, svc, ref)
    all_builds:  list = []  # (cf, svc, ctx)

    for cf in COMPOSE_FILES:
        if not cf.exists():
            continue
        p = _parse_compose(cf, include_edge_gateway=include_edge_gateway)
        for ref, name, tag in p["semver"]:
            item = (cf, ref, name, tag)
            if item not in all_semver:
                all_semver.append(item)
        for svc, ref in p["rolling"]:
            # Blue and green deliberately use the same image. Check/pull it once.
            if not any(old_cf == cf and old_ref == ref for old_cf, _, old_ref in all_rolling):
                all_rolling.append((cf, svc, ref))
        for svc, ctx in p["builds"]:
            all_builds.append((cf, svc, ctx))

    # Collect unique base images from all Dockerfiles
    svc_bases: dict = {}   # (cf, svc) -> [base_refs]
    unique_bases: list = []
    for cf, svc, ctx in all_builds:
        bases = _dockerfile_bases(ctx)
        svc_bases[(cf, svc)] = bases
        for b in bases:
            if b not in unique_bases:
                unique_bases.append(b)

    n_files = sum(1 for f in COMPOSE_FILES if f.exists())
    print(
        f"Checking {len(all_semver)} semver, "
        f"{len(all_rolling)} rolling-tag, "
        f"{len(unique_bases)} build-base image(s) "
        f"across {n_files} compose file(s)..."
    )

    async def _chk_semver(cf, full_ref, name, tag):
        new = await _latest_semver_tag(name, tag, sem)
        print(".", end="", flush=True)
        return cf, full_ref, name, tag, new

    async def _chk_rolling(cf, svc, ref):
        remote = await _remote_digest(ref, sem)
        local  = _local_digests(ref)
        stale  = remote is not None and bool(local) and remote not in local
        print(".", end="", flush=True)
        return cf, svc, ref, stale

    async def _chk_base(base):
        remote = await _remote_digest(base, sem)
        local  = _local_digests(base)
        # If local is absent, assume stale so the rebuild pulls the latest base
        changed = remote is not None and (not local or remote not in local)
        print(".", end="", flush=True)
        return base, changed

    print(f"  semver    [{len(all_semver):2}] ", end="", flush=True)
    s_res = await asyncio.gather(*[_chk_semver(*t) for t in all_semver])
    print()

    print(f"  rolling   [{len(all_rolling):2}] ", end="", flush=True)
    r_res = await asyncio.gather(*[_chk_rolling(*t) for t in all_rolling])
    print()

    print(f"  build base[{len(unique_bases):2}] ", end="", flush=True)
    b_res = await asyncio.gather(*[_chk_base(b) for b in unique_bases])
    print()

    semver_by_file: dict = {}
    for cf, full_ref, name, old, new in s_res:
        if new:
            semver_by_file.setdefault(cf, []).append((full_ref, name, old, new))

    rolling_stale = [(cf, svc, ref) for cf, svc, ref, stale in r_res if stale]

    stale_bases = {b for b, changed in b_res if changed}
    build_stale = [
        (cf, svc, ctx)
        for cf, svc, ctx in all_builds
        if any(b in stale_bases for b in svc_bases.get((cf, svc), []))
    ]

    return {
        "semver_by_file": semver_by_file,
        "rolling_stale":  rolling_stale,
        "build_stale":    build_stale,
        "stale_bases":    stale_bases,
        "svc_bases":      svc_bases,
    }


# ── apply / revert semver tag updates ─────────────────────────────────────────

def _apply_semver(semver_by_file: dict) -> None:
    for cf, items in semver_by_file.items():
        text = cf.read_text()
        for full_ref, name, old_tag, new_tag in items:
            new_ref = f"{name}:{new_tag}"
            for old_s, new_s in [
                (f"image: {full_ref}",   f"image: {new_ref}"),
                (f'image: "{full_ref}"', f'image: "{new_ref}"'),
            ]:
                if old_s in text:
                    text = text.replace(old_s, new_s)
        cf.write_text(text)


def _revert_semver(items: list) -> None:
    """Undo compose file tag changes for images whose pull failed."""
    by_file: dict = {}
    for cf, full_ref, name, old_tag, new_tag in items:
        by_file.setdefault(cf, []).append((name, old_tag, new_tag))
    for cf, changes in by_file.items():
        text = cf.read_text()
        for name, old_tag, new_tag in changes:
            new_ref, old_ref = f"{name}:{new_tag}", f"{name}:{old_tag}"
            for bad, good in [
                (f"image: {new_ref}", f"image: {old_ref}"),
                (f'image: "{new_ref}"', f'image: "{old_ref}"'),
            ]:
                text = text.replace(bad, good)
        cf.write_text(text)


# ── shell helper ───────────────────────────────────────────────────────────────

def _run(cmd: list, check: bool = True) -> int:
    print(f"\n+ {' '.join(str(c) for c in cmd)}")
    result = subprocess.run(cmd, cwd=REPO_ROOT)
    if check and result.returncode != 0:
        print(f"Command failed (exit {result.returncode})", file=sys.stderr)
        sys.exit(result.returncode)
    return result.returncode


# ── auto-commit compose tag bumps ─────────────────────────────────────────────

# Substrings that must never appear in a pushed compose diff. Compose files use
# ${DOMAIN}/${LOCAL} vars, so a literal internal name in a diff means something
# leaked. Matched case-insensitively against added ("+") lines.
LEAK_MARKERS = ("lan", "example")


def _git(args: list) -> subprocess.CompletedProcess:
    return subprocess.run(["git", "-C", str(REPO_ROOT), *args],
                          capture_output=True, text=True)


def _autocommit_compose(applied_bumps: list) -> None:
    """Commit changed compose files and push — unless the diff trips a leak marker.

    applied_bumps: [(image_name, old_tag, new_tag), ...] used only for the message.
    A push failure is non-fatal (the commit stays local).
    """
    if _git(["rev-parse", "--is-inside-work-tree"]).returncode != 0:
        return
    rel = [str(p.relative_to(REPO_ROOT)) for p in COMPOSE_FILES if p.exists()]
    if _git(["diff", "--quiet", "--", *rel]).returncode == 0:
        return  # no file changes (e.g. only rolling-tag pulls)

    diff = _git(["diff", "--", *rel]).stdout
    added = [ln for ln in diff.splitlines()
             if ln.startswith("+") and not ln.startswith("+++")]
    hits = sorted({m for m in LEAK_MARKERS
                   for ln in added if m.lower() in ln.lower()})
    if hits:
        print(f"\n[!] Auto-commit skipped — diff adds {', '.join(hits)}; "
              f"review and commit manually.", file=sys.stderr)
        return

    if applied_bumps:
        summary = ", ".join(f"{name.rsplit('/', 1)[-1]} {old}→{new}"
                            for name, old, new in applied_bumps)
    else:
        summary = "update pinned image tags"
    msg = f"chore(images): {summary}"
    if len(msg) > 72:
        msg = f"chore(images): bump {len(applied_bumps)} image tag(s)"

    _git(["add", "--", *rel])
    commit = _git(["commit", "-m", msg])
    if commit.returncode != 0:
        print(f"\n[!] git commit failed:\n{commit.stderr.strip()}", file=sys.stderr)
        return
    print(f"\n+ git commit -m {msg!r}")
    push = _git(["push"])
    if push.returncode != 0:
        print(f"[!] git push failed (commit is local):\n{push.stderr.strip()}",
              file=sys.stderr)
    else:
        print("+ git push")


# ── remote hosts (--all) ───────────────────────────────────────────────────────

def _update_remote_hosts() -> None:
    """SSH into each remote host and run its own pull/up/prune (or update script)."""
    failed = []
    for host in REMOTE_DC_HOSTS:
        print(f"\n=== {host} ===")
        if _run(["ssh", f"nat@{host}", REMOTE_DC_CMD], check=False) != 0:
            failed.append(host)
    print(f"\n=== {SKETCHY_NAS_HOST} ===")
    if _run(["ssh", f"nat@{SKETCHY_NAS_HOST}", SKETCHY_NAS_CMD], check=False) != 0:
        failed.append(SKETCHY_NAS_HOST)
    if failed:
        print(f"\n[!] Failed on: {', '.join(failed)}", file=sys.stderr)


# ── entry point ────────────────────────────────────────────────────────────────

def main() -> None:
    parser = argparse.ArgumentParser(
        description="Update Docker images: semver bumps, rolling-tag pulls, local rebuilds"
    )
    parser.add_argument("--dry-run", "-n", action="store_true",
                        help="check only, make no changes")
    parser.add_argument("--yes", "-y", action="store_true",
                        help="skip confirmation prompt")
    parser.add_argument("--all", "-a", action="store_true",
                        help="also update beszel/whisper/spark/hermes/sketchy-nas over SSH")
    parser.add_argument("--edge-gateway", action="store_true",
                        help="also check/update HAProxy; briefly interrupts direct LAN/host-port traffic")
    parser.add_argument("--no-commit", action="store_true",
                        help="skip the automatic git commit + push of compose tag bumps")
    args = parser.parse_args()

    results        = asyncio.run(_check_all(include_edge_gateway=args.edge_gateway))
    semver_by_file = results["semver_by_file"]
    rolling_stale  = results["rolling_stale"]
    build_stale    = results["build_stale"]
    stale_bases    = results["stale_bases"]
    svc_bases      = results["svc_bases"]

    # ── display ────────────────────────────────────────────────────────────────
    for cf in COMPOSE_FILES:
        items = semver_by_file.get(cf, [])
        if items:
            print(f"\n{cf.name} — semver updates:")
            for _, name, old, new in items:
                flag = "  [major]" if _sort_key(new)[0] > _sort_key(old)[0] else ""
                print(f"  {name}: {old}  →  {new}{flag}")

    if rolling_stale:
        print("\nRolling-tag images with digest changes:")
        for _, svc, ref in rolling_stale:
            print(f"  {svc}: {ref}")

    if build_stale:
        print("\nLocal builds with stale base images:")
        for cf, svc, _ in build_stale:
            changed = [b for b in svc_bases.get((cf, svc), []) if b in stale_bases]
            print(f"  {svc}: {', '.join(changed)}")

    n_semver  = sum(len(v) for v in semver_by_file.values())
    n_rolling = len(rolling_stale)
    n_builds  = len(build_stale)
    total     = n_semver + n_rolling + n_builds

    print(
        f"\n{n_semver} semver update(s), "
        f"{n_rolling} rolling-tag pull(s), "
        f"{n_builds} local rebuild(s)."
    )
    if args.edge_gateway:
        print("Edge gateway updates enabled (Cloudflare stays up; direct LAN ports briefly restart).")

    if args.dry_run:
        if total:
            print("Dry run — no changes made.")
        if args.all:
            print(f"Dry run — would also update: {', '.join(REMOTE_DC_HOSTS + [SKETCHY_NAS_HOST])}")
        return

    if total == 0 and not args.all:
        return

    # ── confirm ────────────────────────────────────────────────────────────────
    if not args.yes:
        prompt = "\nApply all updates, rebuild, redeploy, and prune"
        prompt += " (then update beszel/whisper/spark/hermes/sketchy-nas over SSH)" if args.all else ""
        prompt += "? [y/N] "
        try:
            resp = input(prompt).strip().lower()
        except (EOFError, KeyboardInterrupt):
            print("\nAborted.")
            return
        if resp != "y":
            print("Aborted.")
            return

    if total == 0:
        _update_remote_hosts()
        return

    main_cf    = REPO_ROOT / "docker-compose.yml"
    openbao_cf = REPO_ROOT / "docker-compose.openbao.yml"
    edge_items = list(semver_by_file.get(EDGE_COMPOSE, []))
    edge_changed = (
        bool(edge_items)
        or any(cf == EDGE_COMPOSE for cf, _, _ in rolling_stale)
        or any(cf == EDGE_COMPOSE for cf, _, _ in build_stale)
    )

    # ── 1. write semver tag changes into compose files ─────────────────────────
    if semver_by_file:
        _apply_semver(semver_by_file)

    # ── 2. pull updated images (rolling stale + new semver tags) ──────────────
    pulled: set = set()
    pull_failed: list = []  # (cf, full_ref, name, old_tag, new_tag)

    for _, _, ref in rolling_stale:
        if ref not in pulled:
            if _run(["docker", "pull", ref], check=False) == 0:
                pulled.add(ref)
            # rolling failure is non-fatal — the old image keeps running

    for cf, items in semver_by_file.items():
        for full_ref, name, old_tag, new_tag in items:
            ref = f"{name}:{new_tag}"
            if ref not in pulled:
                if _run(["docker", "pull", ref], check=False) == 0:
                    pulled.add(ref)
                else:
                    print(f"\n[!] pull failed for {ref} — reverting compose file", file=sys.stderr)
                    pull_failed.append((cf, full_ref, name, old_tag, new_tag))

    if pull_failed:
        _revert_semver(pull_failed)
        print(f"[!] {len(pull_failed)} image(s) reverted in compose file(s).", file=sys.stderr)

    # ── 3. rebuild local builds whose base images changed ─────────────────────
    for cf, svc, _ in build_stale:
        if cf == main_cf:
            _run([str(REPO_ROOT / "dc.sh"), "build", "--pull", svc], check=False)
        else:
            _run(["docker", "compose", "-f", str(cf), "build", "--pull", svc], check=False)

    # ── 4. redeploy ────────────────────────────────────────────────────────────
    # dc.sh handles OpenBao auto-start + secret injection for the main stack.
    _run([str(REPO_ROOT / "dc.sh"), "up", "-d"])

    # Traefik/cloudflared are deliberately absent from the main Compose project.
    # Promote the complete edge pair through the healthy inactive color instead
    # of letting Compose replace the only reverse proxy in place.
    if edge_changed:
        if _run([str(REPO_ROOT / "bin" / "deploy-traefik")], check=False) != 0:
            if edge_items:
                _revert_semver([
                    (EDGE_COMPOSE, full_ref, name, old_tag, new_tag)
                    for full_ref, name, old_tag, new_tag in edge_items
                ])
            print("[!] Edge promotion failed; compose image tags were reverted.", file=sys.stderr)
            sys.exit(1)

    # Redeploy OpenBao stack separately if any of its images changed.
    openbao_changed = (
        openbao_cf in semver_by_file
        or any(cf == openbao_cf for cf, _, _ in rolling_stale)
        or any(cf == openbao_cf for cf, _, _ in build_stale)
    )
    if openbao_changed:
        _run(["docker", "compose", "-f", str(openbao_cf), "up", "-d"])

    # ── 5. prune ───────────────────────────────────────────────────────────────
    # -f only (no -a): removes dangling images but preserves tagged ones.
    # Using -fa would remove build-base images (e.g. python:3.13-slim) that
    # aren't referenced by running containers, causing false-positive stale
    # detection on the next run.
    _run(["docker", "system", "prune", "-f"])

    # ── 6. commit + push the compose tag bumps ────────────────────────────────
    if not args.no_commit:
        failed_refs = {(name, new_tag) for _, _, name, _, new_tag in pull_failed}
        applied_bumps = [
            (name, old_tag, new_tag)
            for items in semver_by_file.values()
            for _, name, old_tag, new_tag in items
            if (name, new_tag) not in failed_refs
        ]
        _autocommit_compose(applied_bumps)

    if args.all:
        _update_remote_hosts()

    print("\nDone.")


if __name__ == "__main__":
    main()
